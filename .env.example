# Copy to .env and fill in real values:  cp .env.example .env
# Never commit .env. It is ignored by Git and excluded from the Docker build context.

# --- Django ---------------------------------------------------------------
# Generate with: docker compose run --rm --no-deps web python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Only read by development settings; production always forces DEBUG off.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins (scheme + host [+ port]) allowed to submit forms, e.g. https://movies.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8888,http://127.0.0.1:8888
# Optional: separate signing key for JWTs (defaults to DJANGO_SECRET_KEY)
JWT_SIGNING_KEY=
# Run migrations + create the cache table when the web container starts (1/0)
DJANGO_MIGRATE_ON_START=1
# Admin URL prefix (change it in production to reduce automated probing)
DJANGO_ADMIN_URL=admin/

# --- Production-only knobs (ignored by development settings) ---------------
# Set the next two to False only when testing the production stack locally over plain HTTP.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_COOKIES=True
DJANGO_SECURE_HSTS_SECONDS=2592000
# True when running behind a TLS-terminating reverse proxy that sets X-Forwarded-Proto/For
DJANGO_BEHIND_PROXY=False
# Let Django serve uploaded avatars (fine for small deployments; use a proxy/object storage at scale)
DJANGO_SERVE_MEDIA=True
GUNICORN_WORKERS=3

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=reelhouse
POSTGRES_USER=reelhouse
POSTGRES_PASSWORD=change-me-db-password
# The Compose service name. Do not use localhost inside containers.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- TMDB ------------------------------------------------------------------
# v3 API key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_LANGUAGE=en-US
# Optional ISO 3166-1 region for "upcoming" / "now playing", e.g. US
TMDB_REGION=
# Seconds before an outbound TMDB request is abandoned
TMDB_TIMEOUT=6

# --- Host port -------------------------------------------------------------
WEB_PORT=8888
